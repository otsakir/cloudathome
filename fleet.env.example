# Fleet size -- how many homes this instance holds and how ports are laid out
# per home. Read only by ./setup (never by the containers), and locked in on
# the instance's first start: editing this afterwards has no effect unless you
# run `./setup --reset`, which wipes the instance.
# Full reference: docs/configuration.md

# Number of home slots.
MAX_HOME_COUNT=2

# Internal SSH tunnel ports (inside tunnelagent, never published).
TUNNEL_PORTS_BASE=2000
TUNNEL_PORTS_PER_HOME=5
TUNNEL_PORTS_PER_HOME_RESERVED=10

# Public raw TCP ports, a dedicated block per home.
TCP_PUBLIC_PORTS_BASE=10000
TCP_PUBLIC_PORTS_PER_HOME=5
