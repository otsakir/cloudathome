# Standard HTTP/HTTPS ports this instance's HAProxy listens on -- normally 80/443,
# but overridable so more than one CloudAtHome instance can run on the same host
# (each needs its own host IP, or its own non-standard ports, since only one
# process can ever bind real 0.0.0.0:80/:443 on a given host). Threaded through
# compose.yaml (published ports + container env vars for both haproxy and
# tunnelagent) and docker/haproxy/haproxy.cfg (bind lines via HAProxy's own $VAR
# expansion). Also the port CAH_HOSTNAME (below) is itself reached on -- so
# these must always match what haproxy.cfg actually binds.
# May safely overlap HTTP_INBOUND_DEFAULT_PORT/HTTPS_INBOUND_DEFAULT_PORT and
# HTTP_INBOUND_PORT_RANGE/HTTPS_INBOUND_PORT_RANGE below -- HAProxy enables
# SO_REUSEPORT on its listeners by default, so bind lines claiming the same
# port coexist without conflict.
CAH_HTTP_PORT=80
CAH_HTTPS_PORT=443

# Required: hostname this instance's own Django (admin/API/web UI) answers on,
# routed through HAProxy -- the only way to reach Django, there's no separate
# published port. Reachable over both HTTP and HTTPS at this instance's
# standard CAH_HTTP_PORT/CAH_HTTPS_PORT above (Django terminates its own HTTPS
# via gunicorn -- see docker/django/certs/ and docs/features.md for the
# cert/key files it expects there). Reserved automatically against home
# base-domain registration once set, e.g.:
#   CAH_HOSTNAME=cloud.example.com
CAH_HOSTNAME=localhost

# Dev/testing-only: lets a home register a base domain that isn't a real
# registrable domain (normally required, checked against the Public Suffix
# List) -- e.g. 'localhost', 'myapp.local', 'myapp.test'. Only relaxes that
# one check -- CAH_HOSTNAME reservation and the overlap checks between
# homes' own domains still apply either way. Leave unset/false on a real
# deployment.
BASE_DOMAIN_ALLOW_NON_REGISTRABLE=false

# Default `public_port` a home's HTTP/HTTPS mapping gets when it omits one on
# POST .../proxy-mappings/<scheme>/ -- deliberately its own setting, not tied
# to CAH_HTTP_PORT/CAH_HTTPS_PORT above, since those are about *this
# instance's* own standard port (and CAH_HOSTNAME's route), a separate concern
# from "what port do homes land on by default". They coincide here out of the
# box, but e.g. an operator moving CAH_HTTP_PORT to a non-standard value for
# multi-instance-on-one-host reasons can leave this at 80 and homes keep
# defaulting there unaffected. Threaded through compose.yaml and
# docker/haproxy/haproxy.cfg the same way as CAH_HTTP_PORT/CAH_HTTPS_PORT,
# with its own bind line -- no need to fall inside any other range.
HTTP_INBOUND_DEFAULT_PORT=80
HTTPS_INBOUND_DEFAULT_PORT=443

# Shared HTTP/HTTPS inbound port range, in "base-max" form (inclusive).
# This single value is threaded through compose.yaml (published ports + container
# env vars) and docker/haproxy/haproxy.cfg (bind lines via HAProxy's own $VAR
# expansion), and read by Django to serve GET /api/config/inbound-ports/<scheme>/.
# Keep it in sync with any manual haproxy.cfg/compose.yaml edits if you change it --
# see haproxy_frontend_ports_and_reload notes in the project docs/memory.
HTTP_INBOUND_PORT_RANGE=8080-8090
HTTPS_INBOUND_PORT_RANGE=8443-8452

# Public port range for raw TCP forwards, in "base-max" form (inclusive). Threaded
# through compose.yaml (published ports) and haproxy.cfg (bind line, via $VAR
# expansion). DERIVED, not hand-set: scripts/generate_fleet_config.py computes
# this from TCP_PUBLIC_PORTS_BASE and MAX_HOME_COUNT * TCP_PUBLIC_PORTS_PER_HOME
# (see below) and overwrites this line. The value below is just the default
# matching this file's other defaults -- edit those instead, then rerun the
# script; don't hand-edit this line, it'll be overwritten.
TCP_PUBLIC_PORT_RANGE=10000-10009

# External SSH port homes connect their reverse tunnel to (advertised to clients
# via the API). Must match the host-side half of tunnelagent's port mapping.
CAH_SSH_PORT=8022

# HAProxy Runtime API port, used by Django to push map updates and by the
# container healthcheck. Internal to the compose network, not published.
HAPROXY_API_PORT=9999

# Fleet-size sizing -- how many homes this instance can hold, and how SSH tunnel
# ports (and the raw TCP public port range above) are laid out per home. Read ONLY
# by scripts/generate_fleet_config.py -- not passed to the containers as env vars.
# That script validates these, generates the tunnel backend blocks in
# docker/haproxy/haproxy.cfg, derives TCP_PUBLIC_PORT_RANGE above, and bakes the
# validated values into docker/django/fleet_config.json, which django.dockerfile
# then builds into the image. Running it is a hard prerequisite for `docker
# compose up --build` -- the build COPYs that generated file and fails if it's
# missing.
#
# INSTALL-TIME ONLY. There is no supported way to change these once the instance
# has homes registered -- growing retroactively leaves earlier homes fine but is
# unverified, and shrinking silently breaks routing for any home whose index
# lands outside the new range. Decide these, then run
# `python3 scripts/generate_fleet_config.py`, before the first `docker compose up
# --build`, and treat them as fixed for the life of the instance; a real change
# means a fresh install. See CLAUDE.md.

# How many home slots this instance can hold (indices 0..MAX_HOME_COUNT-1).
MAX_HOME_COUNT=10

# SSH tunnel ports allocated to each home (its block of ports for HTTP/HTTPS/
# TCP tunnel backends).
PORTS_PER_HOME=10

# Stride between each home's tunnel port block: home <i>'s block starts at
# HOME_PORTS_BASE + i * PORTS_PER_HOME_RESERVED. Must be >= PORTS_PER_HOME --
# validation rejects it otherwise, since adjacent homes' ranges would overlap.
# Any excess over PORTS_PER_HOME is just headroom reserved per home, unused
# today.
PORTS_PER_HOME_RESERVED=10

# Starting port number for home 0's SSH tunnel port block (each subsequent
# home's block starts PORTS_PER_HOME_RESERVED ports higher).
HOME_PORTS_BASE=2000

# Starting port number for the raw TCP public forward range (home 0's block;
# TCP_PUBLIC_PORT_RANGE above is derived from this, MAX_HOME_COUNT, and
# TCP_PUBLIC_PORTS_PER_HOME below).
TCP_PUBLIC_PORTS_BASE=10000

# Dedicated public TCP ports allocated to each home for raw TCP forwards.
TCP_PUBLIC_PORTS_PER_HOME=10
