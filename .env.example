# Shared HTTP/HTTPS inbound port range, in "base-max" form (inclusive).
# This single value is threaded through compose.yaml (published ports + container
# env vars) and docker/haproxy/haproxy.cfg (bind lines via HAProxy's own $VAR
# expansion), and read by Django to serve GET /api/config/inbound-ports/<scheme>/.
# Keep it in sync with any manual haproxy.cfg/compose.yaml edits if you change it --
# see haproxy_frontend_ports_and_reload notes in the project docs/memory.
HTTP_INBOUND_PORT_RANGE=8080-8180
HTTPS_INBOUND_PORT_RANGE=8443-8543

# Public port range for raw TCP forwards, in "base-max" form (inclusive). Threaded
# through compose.yaml (published ports) and haproxy.cfg (bind line, via $VAR
# expansion). Must span exactly MAX_HOME_COUNT * TCP_PUBLIC_PORTS_PER_HOME ports
# starting at TCP_PUBLIC_PORTS_BASE — those live in manage_home.py's Config and
# aren't (yet) derived from this env var, so keep them in sync by hand.
TCP_PUBLIC_PORT_RANGE=10000-10099

# External SSH port homes connect their reverse tunnel to (advertised to clients
# via the API). Must match the host-side half of tunnelagent's port mapping.
CAH_SSH_PORT=8022

# HAProxy Runtime API port, used by Django to push map updates and by the
# container healthcheck. Internal to the compose network, not published.
HAPROXY_API_PORT=9999
