# Full reference for every variable: docs/configuration.md
#
# Changes take effect only when containers are recreated -- always recreate
# both together (`docker compose up -d`). Recreating haproxy clears all
# routing maps, so homes must re-register their mappings.


# Hostname for this instance's admin/API/web UI (required).
CAH_HOSTNAME=localhost

# Standard HTTP/HTTPS ports HAProxy listens on (and CAH_HOSTNAME is served on).
CAH_HTTP_PORT=80
CAH_HTTPS_PORT=443

# Host port homes connect their SSH reverse tunnel to.
CAH_SSH_PORT=8022

# HAProxy Runtime API port (internal to the compose network).
HAPROXY_API_PORT=9999

# Default public port for a home's HTTP/HTTPS mapping when it doesn't pick one.
HTTP_INBOUND_DEFAULT_PORT=80
HTTPS_INBOUND_DEFAULT_PORT=443

# Extra public ports, shared by all homes, for HTTP/HTTPS mappings ("base-max").
# Widening is safe; shrinking breaks mappings on dropped ports.
HTTP_INBOUND_PORT_RANGE=8080-8084
HTTPS_INBOUND_PORT_RANGE=8443-8447

# Dev/testing only: allow non-registrable base domains (e.g. localhost).
BASE_DOMAIN_ALLOW_NON_REGISTRABLE=false


#### calculated environment -- written by ./setup, don't edit

TCP_PUBLIC_PORT_RANGE=10000-10009
